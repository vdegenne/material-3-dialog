{
	"name": "material-3-dialog",
	"version": "0.1.12",
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"scripts": {
		"build": "wireit"
	},
	"files": [
		"./lib/"
	],
	"devDependencies": {
		"@material/web": "^2.5.0",
		"html-vision": "^1.0.5",
		"lit-html": "^3.3.3",
		"typescript": "^7.0.2",
		"wireit": "^0.14.13"
	},
	"peerDependencies": {
		"@material/web": "^2.4.0",
		"lit-html": "^3.3.1",
		"html-vision": "^0.3.6"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	}
}
